# Copy to .env for local runs, then replace both values with long random secrets.
API_KEYS=demo=replace-with-a-long-random-key;telegram-bot=replace-with-another-long-random-key
BOT_PRINCIPAL=telegram-bot
BOT_API_KEY=replace-with-the-same-key-used-for-telegram-bot-in-API_KEYS
DATABASE_PATH=./data/nurtaro.sqlite3
LLM_PROVIDER=extractive
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b-instruct-q4_K_M
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=512
LLM_TIMEOUT_SECONDS=45
OPENAI_COMPATIBLE_BASE_URL=https://api.openai.com/v1
OPENAI_COMPATIBLE_MODEL=qwen2.5
OPENAI_COMPATIBLE_API_KEY=
EMBEDDING_BACKEND=hashing
SENTENCE_TRANSFORMER_MODEL=intfloat/multilingual-e5-small
TOP_K=4
MIN_RETRIEVAL_SCORE=0.08
MAX_UPLOAD_BYTES=5242880
MAX_PDF_PAGES=50
VISION_MODEL=yolo11n.pt
VISION_CONFIDENCE=0.35
VISION_MAX_UPLOAD_BYTES=52428800
VISION_MAX_DURATION_SECONDS=30
VISION_SAMPLE_INTERVAL_SECONDS=1.0
VISION_MAX_FRAMES=30
VISION_MAX_DIMENSION=1920
TELEGRAM_BOT_TOKEN=
API_BASE_URL=http://localhost:8000
